# =================================================================
# Hydra Stream - Control Plane Environment Configuration
# =================================================================

CONTROLLER_PORT=8080
LOG_LEVEL=info

# Discovery Layer: etcd v3 Endpoints
ETCD_ENDPOINTS=http://127.0.0.1:2379
ENABLE_ETCD=true

# Observability Layer: Prometheus Server URL
PROMETHEUS_URL=http://127.0.0.1:9090
ENABLE_PROMETHEUS=true

# Fallback: Zero fake fallback data in production / dynamic mode
SEED_FALLBACK=false
