# =================================================================
# Hydra Stream - Environment Configuration
# =================================================================

# Controller HTTP Server Port
CONTROLLER_PORT=8080

# Logging Level: debug, info, warn, error
LOG_LEVEL=info

# Discovery Layer: etcd v3 Cluster Endpoints (comma-separated)
# In Docker Compose: http://etcd:2379
# In Minikube / K8s: http://hydra-etcd.hydra.svc.cluster.local:2379
# In Local Dev:      http://127.0.0.1:2379
ETCD_ENDPOINTS=http://127.0.0.1:2379
ENABLE_ETCD=true

# Observability Layer: Prometheus Server URL
# In Docker Compose: http://prometheus:9090
# In Minikube / K8s: http://hydra-prometheus.hydra.svc.cluster.local:9090
# In Local Dev:      http://127.0.0.1:9090
PROMETHEUS_URL=http://127.0.0.1:9090
ENABLE_PROMETHEUS=true

# Fallback Mode: Set to false in production/k8s to enforce dynamic discovery
SEED_FALLBACK=false
